# Protect Linux-executed files from Windows CRLF line endings.
# Without this, a .sh committed as CRLF breaks bash on the VPS with
# cryptic errors like: $'\r': command not found
*.sh        text eol=lf
*.service   text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.css       text eol=lf
*.html      text eol=lf
# Windows batch files must STAY CRLF
*.bat       text eol=crlf
