{
  "root": true,
  "env": { "browser": true, "es2022": true },
  "parserOptions": { "ecmaVersion": 2022, "sourceType": "module", "ecmaFeatures": { "jsx": true } },
  "rules": {
    "no-undef": "error",
    "no-dupe-keys": "error",
    "no-unreachable": "error",
    "no-const-assign": "error",
    "no-obj-calls": "error"
  },
  "globals": { "React": "readonly" }
}
